# Optional backend configuration. Local text checks need no .env or API key.
# Keep filled-in secrets only in your git-ignored .env.
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
HOST=127.0.0.1
PORT=4317
# Leave these blank for local use or an SSH tunnel.
PUBLIC_URL=
VERIFEED_ACCESS_TOKEN=
ALLOWED_EXTENSION_ID=
MAX_AI_CHECKS_PER_DAY=80
MAX_AI_CHECKS_PER_MINUTE=4
MAX_AI_TOKENS_PER_DAY=100000

# Browser tests read these from the shell, not this .env file:
# VERIFEED_BROWSER_EXECUTABLE: optional path to a Playwright-compatible Chromium.
# NOVA_BROWSER_EXECUTABLE: legacy alias; prefer VERIFEED_BROWSER_EXECUTABLE.
# NOVA_TEST_EXTENSION: optional folder for test:extension; defaults to extension/.
# LOCALAPPDATA is supplied by Windows for cache discovery. Do not override it.
